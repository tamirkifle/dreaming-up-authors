# Copy this file to `.env` (never commit `.env`) and fill in the values you need.

# ---- API credentials -------------------------------------------------------
# OpenAI: module 04 (open-ended recall) and module 05 (MC recognition, Batch API)
OPENAI_API_KEY=
# BrightData SERP API: module 02 (Google search hit counts)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Semantic Scholar (optional; raises the rate limit): 01/07_fetch_datasets_from_ids.py
# and 05/fetch_collaborators.py
S2_API_KEY=

# ---- Paths (optional) -------------------------------------------------------
# Defaults are ./data and ./results inside the repository. Point these to an
# external drive if you do not have enough local disk space (~50 GB for step 01).
DATA_DIR=
RESULTS_DIR=
# Directory containing the extracted OAG v2 files mag_papers_0.txt ... mag_papers_10.txt
OAG_RAW_DIR=
# NDJSON produced by the Semantic Scholar matching + filtering step
MATCHED_NDJSON=
